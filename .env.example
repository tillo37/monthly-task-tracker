# Supabase connection for the browser.
#
# Both values are safe to expose: the URL is public and the anon (publishable)
# key only grants what Row Level Security allows. Vite inlines every VITE_
# variable into the built bundle, so NEVER put a service-role key here — it
# bypasses RLS entirely and would hand every user's data to anyone who opened
# the site.
#
# Leaving these unset builds the original local-only tracker, with no accounts
# and no leaderboard.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
